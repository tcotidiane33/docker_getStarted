# Alternative Dockerfile with simpler base
FROM ubuntu:latest

# Install Node.js
RUN apt-get update && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy application
COPY server.js .

# Create non-root user
RUN useradd -m -u 2000 appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 3000

CMD ["node", "server.js"]
