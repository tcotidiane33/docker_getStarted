# ❌ MAUVAIS: Dockerfile sans multi-stage (pour comparaison)
FROM ubuntu:latest

# Installer Go (lourd!)
RUN apt-get update && \
    apt-get install -y golang-go && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY go.mod main.go ./

# Compiler
RUN go build -o server main.go

EXPOSE 8080

CMD ["./server"]

# Résultat: Image de ~800MB avec tout le SDK Go!
